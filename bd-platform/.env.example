# Required for Agents 3-14 (audits, scoring, proposal copy, outreach)
ANTHROPIC_API_KEY=

# Optional — Agent 1/2 real YouTube stats. Without it, discovery falls back to manual seed values.
YOUTUBE_API_KEY=

# Optional — Agent 1 Spotify show lookup (client-credentials flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dashboard
PORT=3000

# Required — Postgres connection string. On Replit, open the Database pane to provision
# Postgres; it injects DATABASE_URL into Secrets automatically. Locally, point this at any
# Postgres instance (e.g. postgresql://user:pass@localhost:5432/tcd).
DATABASE_URL=

# Required — protects the dashboard with HTTP Basic Auth (browser will prompt for these).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional — lets the dashboard send outreach/follow-up emails directly via a connected Gmail
# account (Send button on the creator page) instead of copy/paste only. From Google Cloud
# Console: create an OAuth 2.0 Client ID (Web application), add
# https://<your-replit-domain>/auth/google/callback as an authorized redirect URI, and enable
# the Gmail API. Without these two set, the dashboard just doesn't show a Connect Gmail option.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override — only needed if the request's own host/protocol don't match what's
# registered in Google Cloud Console (e.g. behind a proxy that changes the visible host).
GOOGLE_REDIRECT_URI=
