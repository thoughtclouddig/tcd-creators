<!doctype html>
<html>
<head><%- include('partials/head', { title: 'Pipeline' }) %></head>
<body>
<%- include('partials/topbar', { active: 'pipeline' }) %>

<main class="wrap">
  <div class="page-head">
    <div class="kicker">CRM</div>
    <h1>Pipeline</h1>
    <p>Every creator with outreach drafted, with status, opportunity value, and close probability. Nothing here has been sent — this system only ever drafts; "contacted" and later stages only appear once you mark them yourself after actually reaching out.</p>
  </div>

  <% if (rows.length === 0) { %>
    <div class="empty">Nothing in the pipeline yet — outreach hasn't been drafted for any creator.</div>
  <% } else { %>
  <div class="kanban" id="kanban">
    <% statusColumns.forEach(function(col) { %>
    <% var colRows = rows.filter(function(r) { return r.crm_status === col.key; }) %>
    <div class="kanban-col" data-status="<%= col.key %>">
      <div class="kanban-col-head">
        <h3><%= col.label %></h3>
        <span class="count"><%= colRows.length %></span>
      </div>
      <% if (colRows.length === 0) { %>
        <div class="kanban-empty">—</div>
      <% } %>
      <% colRows.forEach(function(r) { %>
      <a class="kanban-card" href="/creators/<%= r.id %>" draggable="true" data-id="<%= r.id %>">
        <span class="name"><%= r.name %></span>
        <div class="meta">
          <span><%= r.opportunity_value_usd ? ('$' + Number(r.opportunity_value_usd).toLocaleString()) : '—' %></span>
          <b><%= r.close_probability_pct ? r.close_probability_pct + '%' : '—' %></b>
        </div>
      </a>
      <% }) %>
    </div>
    <% }) %>
  </div>
  <p class="muted" style="font-size:.82rem;margin-top:14px">Drag a card between columns to update its status — this is the only thing in the whole system that represents something you actually did, not a draft.</p>
  <% } %>

  <div class="section">
    <details class="collapsible">
      <summary>Recent Pipeline Runs</summary>
      <% if (runs.length === 0) { %>
        <div class="empty">No agent runs logged yet.</div>
      <% } else { %>
      <table>
        <thead><tr><th>Creator</th><th>Status</th><th>Started</th><th>Finished</th></tr></thead>
        <tbody>
          <% runs.forEach(function(r) { %>
          <tr>
            <td class="name-cell"><%= r.creator_name %></td>
            <td><span class="badge <%= r.status === 'completed' ? 'badge-high' : (r.status === 'failed' ? 'badge-bad' : 'badge-status') %>"><%= r.status %></span></td>
            <td class="muted"><%= fmtDate(r.started_at) %></td>
            <td class="muted"><%= r.finished_at ? fmtDate(r.finished_at) : '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </details>
  </div>
</main>
<script>
  (function () {
    var board = document.getElementById('kanban');
    if (!board) return;
    var dragged = null;

    function updateCount(col) {
      var count = col.querySelectorAll('.kanban-card').length;
      var span = col.querySelector('.kanban-col-head .count');
      if (span) span.textContent = count;
      var empty = col.querySelector('.kanban-empty');
      if (count > 0 && empty) empty.remove();
      if (count === 0 && !empty) {
        var div = document.createElement('div');
        div.className = 'kanban-empty';
        div.textContent = '—';
        col.appendChild(div);
      }
    }

    board.querySelectorAll('.kanban-card').forEach(function (card) {
      card.addEventListener('dragstart', function (e) {
        dragged = card;
        card.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', card.dataset.id);
      });
      card.addEventListener('dragend', function () {
        card.classList.remove('dragging');
        dragged = null;
      });
    });

    board.querySelectorAll('.kanban-col').forEach(function (col) {
      col.addEventListener('dragover', function (e) {
        e.preventDefault();
        col.classList.add('drag-over');
      });
      col.addEventListener('dragleave', function () {
        col.classList.remove('drag-over');
      });
      col.addEventListener('drop', function (e) {
        e.preventDefault();
        col.classList.remove('drag-over');
        if (!dragged) return;
        var id = dragged.dataset.id;
        var status = col.dataset.status;
        var fromCol = dragged.closest('.kanban-col');
        if (fromCol === col) return;
        fetch('/creators/' + id + '/crm-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: status }),
        })
          .then(function (res) {
            if (!res.ok) {
              return res.text().then(function (text) {
                throw new Error('HTTP ' + res.status + ': ' + text.slice(0, 300));
              });
            }
            col.appendChild(dragged);
            updateCount(col);
            if (fromCol) updateCount(fromCol);
          })
          .catch(function (err) {
            alert('Could not update status:\n\n' + err.message);
          });
      });
    });
  })();
</script>
</body>
</html>
