<!doctype html>
<html>
<head><%- include('partials/head', { title: 'Pipeline' }) %></head>
<body>
<%- include('partials/topbar', { active: 'pipeline' }) %>

<main class="wrap">
  <div class="page-head">
    <div class="kicker">CRM</div>
    <h1>Pipeline</h1>
    <p>Every creator that's had outreach initiated, with status, opportunity value, and close probability.</p>
  </div>

  <% if (rows.length === 0) { %>
    <div class="empty">Nothing in the pipeline yet — outreach hasn't been generated for any creator.</div>
  <% } else { %>
  <table>
    <thead><tr><th>Creator</th><th>Status</th><th>Opportunity Value</th><th>Close Probability</th><th>Follow-ups</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(function(r) { %>
      <tr>
        <td class="name-cell"><%= r.name %></td>
        <td><span class="badge badge-status"><%= r.crm_status %></span></td>
        <td class="muted"><%= r.opportunity_value_usd ? ('$' + Number(r.opportunity_value_usd).toLocaleString()) : '—' %></td>
        <td class="muted"><%= r.close_probability_pct ? r.close_probability_pct + '%' : '—' %></td>
        <td class="muted"><%= r.followUpCount %> scheduled</td>
        <td><a class="see-all" href="/creators/<%= r.id %>">View →</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <div class="section">
    <div class="section-head"><h2>Recent Pipeline Runs</h2></div>
    <% if (runs.length === 0) { %>
      <div class="empty">No agent runs logged yet.</div>
    <% } else { %>
    <table>
      <thead><tr><th>Creator</th><th>Status</th><th>Started</th><th>Finished</th></tr></thead>
      <tbody>
        <% runs.forEach(function(r) { %>
        <tr>
          <td class="name-cell"><%= r.creator_name %></td>
          <td><span class="badge <%= r.status === 'completed' ? 'badge-high' : (r.status === 'failed' ? 'badge-low' : 'badge-status') %>"><%= r.status %></span></td>
          <td class="muted"><%= r.started_at %></td>
          <td class="muted"><%= r.finished_at || '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</main>
</body>
</html>
