<!doctype html>
<html>
<head><%- include('partials/head', { title: 'Discover' }) %></head>
<body>
<%- include('partials/topbar', { active: 'discover' }) %>

<main class="wrap">
  <div class="page-head">
    <div class="kicker">Agent 1 — Discovery</div>
    <h1>Add a creator</h1>
    <p>Phase 1 intake is curated: seed a creator here and the full 14-agent pipeline runs against them — enrichment, audits, scoring, proposal, and outreach.</p>
  </div>

  <% if (queued) { %>
    <div class="card" style="margin-bottom:32px;border-color:rgba(76,141,255,.4)">
      <span class="kicker">Queued</span>
      <p style="margin-top:10px;color:var(--ink-soft)">Pipeline running for <strong style="color:var(--ink)"><%= queued %></strong> in the background. This takes a few minutes (14 agents, mostly Claude calls) — refresh the <a class="see-all" href="/pipeline">pipeline page</a> to check progress.</p>
    </div>
  <% } %>

  <form class="seed-form" method="POST" action="/discover">
    <div class="full">
      <label>Creator / Show Name *</label>
      <input name="name" required placeholder="Real Baron">
    </div>
    <div>
      <label>Brand</label>
      <input name="brand" placeholder="Real Baron Podcast">
    </div>
    <div>
      <label>Website</label>
      <input name="website" placeholder="https://realbaron.com">
    </div>
    <div>
      <label>YouTube handle</label>
      <input name="youtube_handle" placeholder="realbaronpodcast">
    </div>
    <div>
      <label>YouTube channel ID (optional, overrides handle)</label>
      <input name="youtube_channel_id" placeholder="UC...">
    </div>
    <div>
      <label>Substack URL</label>
      <input name="substack_url" placeholder="https://realbaron.substack.com">
    </div>
    <div>
      <label>X handle</label>
      <input name="x_handle" placeholder="realbaron">
    </div>
    <div>
      <label>Topics (comma separated)</label>
      <input name="topics" placeholder="politics, constitutional law">
    </div>
    <div class="full">
      <label>Political alignment (descriptive only)</label>
      <input name="political_alignment" placeholder="e.g. populist-right commentary">
    </div>
    <div class="full">
      <button class="btn" type="submit">Run full pipeline →</button>
    </div>
  </form>

  <div class="section">
    <div class="section-head">
      <h2>Discovery Sweep</h2>
    </div>
    <p style="color:var(--ink-soft);max-width:70ch;margin-bottom:22px">
      Searches YouTube by ICP keyword, filters out creators already in the system and anyone
      outside a sensible subscriber range, and stores new candidates with a basic audience
      snapshot — no Claude calls, so this is cheap to run often. Discovered creators show up
      as "Needs Audit" on the dashboard; you decide which ones get the full 14-agent treatment.
    </p>

    <% if (sweepQueued) { %>
      <div class="card" style="margin-bottom:24px;border-color:rgba(76,141,255,.4)">
        <span class="kicker">Sweep running</span>
        <p style="margin-top:10px;color:var(--ink-soft)">Searching YouTube in the background — check the <a class="see-all" href="/">dashboard</a> in a minute or two for new "Needs Audit" creators.</p>
      </div>
    <% } %>

    <form method="POST" action="/discover/sweep">
      <label style="display:block;font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:6px">
        ICP search queries (one per line — leave as-is to use the defaults)
      </label>
      <textarea name="queries" rows="6" style="width:100%;background:var(--bg-elev);border:1px solid var(--glass-border);border-radius:8px;padding:12px 13px;color:var(--ink);font-family:var(--mono);font-size:.85rem;margin-bottom:16px"><%= defaultQueries.join('\n') %></textarea>
      <button class="btn" type="submit">Run discovery sweep →</button>
    </form>
  </div>
</main>
</body>
</html>
