<!doctype html>
<html>
<head><%- include('partials/head', { title: creator.name }) %></head>
<body>
<%- include('partials/topbar', { active: '' }) %>

<main class="wrap">
  <a href="/" class="see-all" style="display:inline-block;margin-bottom:22px">← Dashboard</a>
  <div class="hero">
    <div>
      <div class="kicker"><%= creator.source %> · discovered <%= fmtDate(creator.discovered_at) %></div>
      <h1><%= creator.name %></h1>
      <p class="muted" style="display:flex;gap:16px;flex-wrap:wrap">
        <% if (creator.website) { %><a href="<%= creator.website %>" target="_blank" style="color:var(--accent)"><%= creator.website %></a><% } %>
        <% if (creator.youtube_channel_id) { %><a href="https://www.youtube.com/channel/<%= creator.youtube_channel_id %>/about" target="_blank" style="color:var(--accent)">YouTube channel →</a><% } %>
      </p>
      <form method="POST" action="/creators/<%= creator.id %>/business-email" style="margin-top:10px;display:flex;gap:8px;align-items:center">
        <label style="font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint)">Business email</label>
        <input name="business_email" type="email" value="<%= creator.business_email || '' %>" placeholder="open YouTube → About → copy email" style="background:var(--bg-elev);border:1px solid var(--glass-border);border-radius:6px;padding:6px 10px;color:var(--ink);font-family:var(--mono);font-size:.8rem;width:280px">
        <button class="see-all" type="submit" style="background:none;border:none;cursor:pointer">Save</button>
      </form>
    </div>
    <% if (score) { %>
    <div class="score-big">
      <div class="num"><%= score.overall_score %></div>
      <div class="lbl"><%= score.priority %> Priority · TopFan <%= score.topfan_fit_score %>/100</div>
    </div>
    <% } else { %>
    <div class="score-big">
      <span class="badge badge-warn">Needs Audit</span>
    </div>
    <% } %>
  </div>

  <% if (!score) { %>
  <div class="card" style="margin-bottom:48px;<%= auditQueued ? 'border-color:rgba(76,141,255,.4)' : '' %>">
    <% if (auditQueued) { %>
      <span class="kicker">Audit running</span>
      <p style="margin-top:10px;color:var(--ink-soft)">Full 14-agent audit running in the background — refresh this page in a few minutes.</p>
    <% } else { %>
      <span class="kicker">Discovered, not yet audited</span>
      <p style="margin-top:10px;margin-bottom:18px;color:var(--ink-soft)">This creator was surfaced by a discovery sweep but hasn't had the full audit run yet — no Claude calls have been spent on them.</p>
      <form method="POST" action="/creators/<%= creator.id %>/audit">
        <button class="btn" type="submit">Run full audit →</button>
      </form>
    <% } %>
  </div>
  <% } %>

  <% if (proposal) { %>
  <div style="margin-bottom:48px;display:flex;gap:14px;align-items:center;flex-wrap:wrap">
    <a class="proposal-link" href="/creators/<%= creator.id %>/proposal" target="_blank">Open Executive Proposal →</a>
    <form method="POST" action="/creators/<%= creator.id %>/regenerate-proposal">
      <button class="see-all" type="submit" style="background:none;border:none;cursor:pointer">Regenerate →</button>
    </form>
  </div>
  <% } else if (score) { %>
  <div style="margin-bottom:48px">
    <form method="POST" action="/creators/<%= creator.id %>/regenerate-proposal">
      <button class="btn" type="submit">Generate Executive Proposal →</button>
    </form>
  </div>
  <% } %>

  <% if (snapshot) { %>
  <div class="section" style="margin-top:0">
    <div class="section-head"><h2>Audience Intelligence</h2></div>
    <div class="grid grid-4">
      <div class="card stat-card"><span class="kicker">Subscribers</span><div class="stat-value" style="font-size:1.8rem"><%= snapshot.subscribers ?? '—' %></div></div>
      <div class="card stat-card"><span class="kicker">Avg Views</span><div class="stat-value" style="font-size:1.8rem"><%= snapshot.avg_views ?? '—' %></div></div>
      <div class="card stat-card"><span class="kicker">Posting Freq / wk</span><div class="stat-value" style="font-size:1.8rem"><%= snapshot.posting_frequency_per_week ?? '—' %></div></div>
      <div class="card stat-card"><span class="kicker">Momentum</span><div class="stat-value" style="font-size:1.8rem"><%= snapshot.momentum_score ?? '—' %></div></div>
    </div>
  </div>
  <% } %>

  <% if (audits.length > 0) { %>
  <div class="section">
    <div class="section-head"><h2>Audits</h2></div>
    <div class="grid grid-3">
      <% audits.forEach(function(a) { %>
      <div class="card audit-card">
        <h3><%= a.label %> <span class="score"><%= Math.round(a.score) %><%= a.grade ? ' · ' + a.grade : '' %></span></h3>
        <p><%= a.summary %></p>
        <ul>
          <% a.findings.slice(0,3).forEach(function(f) { %>
            <li><strong style="color:var(--ink-soft)"><%= f.label %>:</strong> <%= f.detail %></li>
          <% }) %>
        </ul>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% if (outreach.length) { %>
  <div class="section">
    <div class="section-head">
      <h2>Outreach Drafts</h2>
      <span class="badge badge-warn">Not sent — draft only</span>
      <form method="POST" action="/creators/<%= creator.id %>/regenerate-outreach">
        <button class="see-all" type="submit" style="background:none;border:none;cursor:pointer">Regenerate →</button>
      </form>
    </div>
    <p style="color:var(--ink-faint);font-size:.85rem;margin-bottom:20px;margin-top:-10px">Text only. Nothing here is connected to email, X, or LinkedIn — copy and send manually if you want to use it.</p>
    <div class="card">
      <% outreach.forEach(function(o) { %>
      <div class="outreach-block">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <span class="chan"><%= o.channel %></span>
          <button class="copy-btn see-all" type="button" data-target="copy-<%= o.id %>" style="background:none;border:none;cursor:pointer">Copy →</button>
        </div>
        <% if (o.subject) { %><div class="subject"><%= o.subject %></div><% } %>
        <div class="body"><%= o.body %></div>
        <textarea id="copy-<%= o.id %>" style="position:absolute;left:-9999px;top:-9999px" readonly tabindex="-1" aria-hidden="true"><%= o.subject ? (o.subject + '\n\n' + o.body) : o.body %></textarea>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% if (followUps.length) { %>
  <div class="section">
    <div class="section-head"><h2>Follow-up Drafts</h2></div>
    <p style="color:var(--ink-faint);font-size:.85rem;margin-bottom:20px;margin-top:-10px">Drafted for the dates below, not sent — "scheduled" here just means "not yet marked sent or skipped by you."</p>
    <table>
      <thead><tr><th>Day</th><th>Target date</th><th>Status</th><th>Preview</th><th></th></tr></thead>
      <tbody>
        <% followUps.forEach(function(f) { %>
        <tr>
          <td class="muted">Day <%= f.day_offset %></td>
          <td class="muted"><%= fmtDateOnly(f.scheduled_date) %></td>
          <td><span class="badge badge-status"><%= f.status === 'scheduled' ? 'drafted' : f.status %></span></td>
          <td class="muted"><%= f.body.slice(0, 90) %>…</td>
          <td>
            <button class="copy-btn see-all" type="button" data-target="copy-fu-<%= f.id %>" style="background:none;border:none;cursor:pointer">Copy →</button>
            <textarea id="copy-fu-<%= f.id %>" style="position:absolute;left:-9999px;top:-9999px" readonly tabindex="-1" aria-hidden="true"><%= f.body %></textarea>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <% if (crm) { %>
  <div class="section">
    <div class="section-head"><h2>CRM</h2></div>
    <div class="grid grid-3">
      <div class="card stat-card"><span class="kicker">Status</span><div class="stat-value" style="font-size:1.6rem;font-family:var(--mono);color:var(--accent)"><%= crm.status %></div></div>
      <div class="card stat-card"><span class="kicker">Opportunity Value</span><div class="stat-value" style="font-size:1.8rem"><%= crm.opportunity_value_usd ? ('$' + Number(crm.opportunity_value_usd).toLocaleString()) : '—' %></div></div>
      <div class="card stat-card"><span class="kicker">Close Probability</span><div class="stat-value" style="font-size:1.8rem"><%= crm.close_probability_pct ?? '—' %>%</div></div>
    </div>
  </div>
  <% } %>

</main>
<script>
  document.querySelectorAll('.copy-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var ta = document.getElementById(btn.dataset.target);
      var reset = function () { btn.textContent = 'Copy →'; };
      var done = function () {
        btn.textContent = 'Copied ✓';
        setTimeout(reset, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(ta.value).then(done, function () { fallbackCopy(ta, done); });
      } else {
        fallbackCopy(ta, done);
      }
    });
  });
  function fallbackCopy(ta, done) {
    ta.style.position = 'fixed';
    ta.focus();
    ta.select();
    try { document.execCommand('copy'); done(); } catch (e) {}
    ta.style.position = 'absolute';
  }
</script>
</body>
</html>
