modules = ["nodejs-20", "web"]

run = "cd bd-platform && npm install && npm run dashboard"
entrypoint = "bd-platform/src/server/index.ts"

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "cd bd-platform && npm install"]
run = ["sh", "-c", "cd bd-platform && npm run dashboard"]

[[ports]]
localPort = 3000
externalPort = 80
