run = "npm install --include=dev && PORT=5000 ./node_modules/.bin/tsx src/server/index.ts"
entrypoint = "src/server/index.ts"
modules = ["nodejs-24", "python-3.11"]

[env]
NODE_ENV = "production"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd bd-platform && npm install --include=dev && PORT=5000 ./node_modules/.bin/tsx src/server/index.ts"
waitForPort = 5000
